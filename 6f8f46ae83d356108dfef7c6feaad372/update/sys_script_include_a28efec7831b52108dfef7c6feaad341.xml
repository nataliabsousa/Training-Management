        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingValidation = Class.create();
TrainingValidation.prototype = {
	initialize: function () { },

	isUserRegistered: function () {
		var arTrainings = [];
		var currentUser = gs.getUser();

		var reg = new GlideRecord('x_1593178_traini_0_enrollments');
		reg.addEncodedQuery('opened_by=' + currentUser.getID());
		reg.query();


		while (reg.next()) {
			arTrainings.push(reg.getValue('schedule'));
		}

		return 'sys_idNOT IN' + arTrainings.join(',');
	},

	type: 'TrainingValidation'
};
]]></script>
