        <script><![CDATA[var verifySchedules = Class.create();
verifySchedules.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	verifySchedules: function () {
		var date = this.getParameter("sysparm_date");
		var course = this.getParameter("sysparm_course");
		
		var grSchedules = new GlideRecord('x_1593178_traini_0_schedules');
		grSchedules.addEncodedQuery("date=" + date + "^course=" + course);
		grSchedules.query();

		if (grSchedules.next()) {
			return true;
		} else {
			return false;
		}
	},

	type: 'verifySchedules'
});]]></script>
