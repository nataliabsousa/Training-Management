        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
	if (isLoading || newValue == '') {
		return;
	}

	var gaCourses = new GlideAjax('verifyTrainings');
	gaCourses.addParam('sysparm_name', 'verifyCourses');
	gaCourses.addParam('sysparm_course', newValue);

	gaCourses.getXMLAnswer(CourseParse);
}

function CourseParse(response) {
	var result = response;

	if (result == 'true'){
		g_form.addErrorMessage('You have already taken the course 3 times, you cannot take it again.');
		g_form.clearValue('course');
		g_form.clearValue('description');
		g_form.clearOptions('schedule');
		return false;
	} else {
		g_form.clearMessages();
	}
}]]></script>
