        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var course = current.getValue('course');
	var date = current.getValue('date');
	var intructor = current.getValue('instructor');

	var grSchedule = new GlideRecord('x_1593178_traini_0_schedules');
	grSchedule.addEncodedQuery('date=' + date + '^course=' + course + '^instructor=' + intructor);
	grSchedule.query();
	gs.info('Natalia date=' + date + '^course=' + course + '^instructor=' + intructor);

	if (grSchedule.next()) {
		gs.addErrorMessage('The record already exists with the same course/date/instructor in the database.');
		current.setAbortAction(true);
	}

})(current, previous);]]></script>
