        <name>ValidateScheduleConflictAjax</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var ValidateScheduleConflictAjax = Class.create();
ValidateScheduleConflictAjax.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    
    checkConflict: function() {
        var courseID = this.getParameter('sysparm_course_id');
        var scheduleDate = this.getParameter('sysparm_schedule_date');

        var scheduleGR = new GlideRecord('x_1593178_traini_0_schedules'); // Tabela de agendas
        scheduleGR.addQuery('course', courseID);
        scheduleGR.addQuery('date', scheduleDate);
        scheduleGR.query();

        if (scheduleGR.next()) {
            return 'true'; // Conflito encontrado
        }
        return 'false'; // Sem conflito
    }
});]]></script>
