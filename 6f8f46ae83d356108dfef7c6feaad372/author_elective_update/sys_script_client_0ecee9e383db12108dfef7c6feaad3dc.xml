    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Habilitar opções por curso</description>
        <field>course</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Enable options by course</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
	if (isLoading || newValue === '') {
		return;
	}

	var ga = new GlideAjax('GetAvailableSchedules');
	ga.addParam('sys_id_curso', newValue);

	ga.getXMLAnswer(function (response) {
		var schedulesData = JSON.parse(response);  // Converte a resposta para um array

		// Limpa o campo de schedules antes de adicionar novos valores
		g_form.clearOptions('schedule');  // Supondo que o campo de schedule seja chamado "schedule"

		if (schedulesData.length > 0) {
			schedulesData.forEach(function (item) {
				var parts = item.split(',');
				var sysId = parts[0];
				var scheduleDate = parts[1];

				// Adiciona as opções ao campo de schedule
				g_form.addOption('schedule', sysId, scheduleDate);
			});
		} else {
			// Caso não haja agendamentos disponíveis, adiciona uma opção indicando isso
			g_form.addOption('schedule', '', 'Nenhum horário disponível');
		}
	});

}]]></script>
