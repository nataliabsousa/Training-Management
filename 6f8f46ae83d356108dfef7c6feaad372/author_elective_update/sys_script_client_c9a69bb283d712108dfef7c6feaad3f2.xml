        <messages/>
        <name>BlockSaveConflictOccurs</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var courseID = g_form.getValue('course');
    var scheduleDate = g_form.getValue('date');

    var ga = new GlideAjax('ValidateScheduleConflictAjax');
    ga.addParam('sysparm_name', 'checkConflict');
    ga.addParam('sysparm_course_id', courseID);
    ga.addParam('sysparm_schedule_date', scheduleDate);

    var conflictExists = false;
    ga.getXMLAnswer(function(response) {
        if (response === 'true') {
            g_form.addErrorMessage('Error: There is already training for this course on this date!');
            conflictExists = true;
        }
    });

    return !conflictExists; // Bloqueia o envio se houver conflito
}]]></script>
