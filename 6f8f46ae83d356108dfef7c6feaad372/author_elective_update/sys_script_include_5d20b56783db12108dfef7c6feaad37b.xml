        <description/>
        <mobile_callable>false</mobile_callable>
        <name>GetAvailableSchedules</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetAvailableSchedules = Class.create();
GetAvailableSchedules.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	getAvailableSchedules: function () {
		var cursoSysId = this.getParameter('sys_id_curso');

		if (!cursoSysId) {
			return '';  // Retorna vazio caso o parâmetro seja inválido
		}

		var gr = new GlideRecord('x_1593178_traini_0_schedules');
		gr.addEncodedQuery('course=' + cursoSysId + '^quantity_available>0');
		gr.query();

		var schedules = [];
		while (gr.next()) {
			schedules.push(gr.sys_id + ',' + gr.schedule_date);
		}

		return JSON.stringify(schedules);
	},

	type: 'GetAvailableSchedules'
});]]></script>
