        <messages/>
        <name>Validate Schedule Conflict</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || g_form.getValue('course') == '' || g_form.getValue('date') == '') {
        return;
    }

    var ga = new GlideAjax('ValidateScheduleConflictAjax');
    ga.addParam('sysparm_name', 'checkConflict');
    ga.addParam('sysparm_course_id', g_form.getValue('course'));
    ga.addParam('sysparm_schedule_date', g_form.getValue('date'));

    ga.getXMLAnswer(function(response) {
        if (response === 'true') {
            g_form.addErrorMessage('Error: There is already training for this course on this date!');
            g_form.clearValue('date'); // Reseta a data inválida
        }
    });
}]]></script>
